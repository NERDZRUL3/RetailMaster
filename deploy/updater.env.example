# Copy to ~/.config/retail-updater.env on the production server.
# No secrets belong here: the database password stays in ~/secrets.

# GitHub repository (owner/name) and branch to install from
REPO=owner/name
BRANCH=main

# Hours (server time) when updates may be installed, e.g. 22-6 for 22:00 to
# 06:00. Empty: any time. Set this once shops use the system during the day.
DEPLOY_HOURS=

# 1: install only commits whose GitHub CI checks all passed
REQUIRE_CI=1

# Paths (defaults shown)
#BENCH=$HOME/frappe-bench
#SRC=$HOME/src/repo
#STATE=$HOME/updater
#SITE=            # default: the bench's current site
